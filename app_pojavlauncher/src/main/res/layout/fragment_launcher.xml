<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
 xmlns:android="http://schemas.android.com/apk/res/android"
 xmlns:app="http://schemas.android.com/apk/res-auto"
 xmlns:tools="http://schemas.android.com/tools"
 android:id="@+id/fragment_menu_main"
 android:layout_width="match_parent"
 android:layout_height="match_parent"
 android:background="@android:color/black">

 <LinearLayout
 android:id="@+id/top_bar"
 android:layout_width="0dp"
 android:layout_height="wrap_content"
 android:layout_marginStart="16dp"
 android:layout_marginTop="16dp"
 android:layout_marginEnd="16dp"
 android:gravity="end"
 android:orientation="horizontal"
 app:layout_constraintEnd_toEndOf="parent"
 app:layout_constraintStart_toStartOf="parent"
 app:layout_constraintTop_toTopOf="parent">

 <ImageButton
 android:id="@+id/news_button"
 android:layout_width="40dp"
 android:layout_height="40dp"
 android:layout_marginEnd="8dp"
 android:background="@android:color/transparent"
 android:src="@drawable/ic_px_book"
 android:tint="@android:color/white" />

 <ImageButton
 android:id="@+id/open_files_button"
 android:layout_width="40dp"
 android:layout_height="40dp"
 android:layout_marginEnd="8dp"
 android:background="@android:color/transparent"
 android:src="@drawable/ic_px_folder"
 android:tint="@android:color/white" />

 <ImageButton
 android:id="@+id/share_logs_button"
 android:layout_width="40dp"
 android:layout_height="40dp"
 android:layout_marginEnd="8dp"
 android:background="@android:color/transparent"
 android:src="@drawable/ic_px_file_dl"
 android:tint="@android:color/white" />

 <ImageButton
 android:id="@+id/social_media_button"
 android:layout_width="40dp"
 android:layout_height="40dp"
 android:background="@android:color/transparent"
 android:src="@drawable/ic_px_sliders"
 android:tint="@android:color/white" />
 </LinearLayout>

 <LinearLayout
 android:id="@+id/profile_card"
 android:layout_width="0dp"
 android:layout_height="wrap_content"
 android:layout_marginStart="20dp"
 android:layout_marginTop="20dp"
 android:layout_marginEnd="20dp"
 android:background="@drawable/background_card"
 android:gravity="center_vertical"
 android:orientation="horizontal"
 android:padding="16dp"
 app:layout_constraintEnd_toEndOf="parent"
 app:layout_constraintStart_toStartOf="parent"
 app:layout_constraintTop_toBottomOf="@id/top_bar">

 <LinearLayout
 android:layout_width="0dp"
 android:layout_height="wrap_content"
 android:layout_weight="1"
 android:orientation="vertical">

 <TextView
 android:id="@+id/profile_title"
 android:layout_width="wrap_content"
 android:layout_height="wrap_content"
 android:text="GITHUB account"
 android:textColor="#BDBDBD"
 android:textSize="12sp" />

 <TextView
 android:id="@+id/profile_name"
 android:layout_width="wrap_content"
 android:layout_height="wrap_content"
 android:layout_marginTop="4dp"
 android:text="KIUA"
 android:textColor="@android:color/white"
 android:textSize="22sp"
 android:textStyle="bold" />
 </LinearLayout>

 <ImageButton
 android:id="@+id/edit_profile_button"
 android:layout_width="44dp"
 android:layout_height="44dp"
 android:background="@android:color/transparent"
 android:src="@drawable/ic_px_edit"
 android:tint="@android:color/white" />
 </LinearLayout>

 <LinearLayout
 android:id="@+id/center_content"
 android:layout_width="wrap_content"
 android:layout_height="wrap_content"
 android:gravity="center"
 android:orientation="vertical"
 app:layout_constraintBottom_toTopOf="@id/bottom_panel"
 app:layout_constraintEnd_toEndOf="parent"
 app:layout_constraintStart_toStartOf="parent"
 app:layout_constraintTop_toBottomOf="@id/profile_card">

 <TextView
 android:id="@+id/main_logo"
 android:layout_width="wrap_content"
 android:layout_height="wrap_content"
 android:text="X"
 android:textColor="@android:color/white"
 android:textSize="88sp"
 android:textStyle="bold" />

 <TextView
 android:id="@+id/welcome_label"
 android:layout_width="wrap_content"
 android:layout_height="wrap_content"
 android:layout_marginTop="8dp"
 android:text="WELCOME"
 android:textColor="#CFCFFF"
 android:textSize="12sp" />

 <TextView
 android:id="@+id/enjoy_label"
 android:layout_width="wrap_content"
 android:layout_height="wrap_content"
 android:layout_marginTop="4dp"
 android:text="ENJOY"
 android:textColor="#CFCFFF"
 android:textSize="12sp" />
 </LinearLayout>

 <LinearLayout
 android:id="@+id/bottom_panel"
 android:layout_width="0dp"
 android:layout_height="wrap_content"
 android:layout_marginStart="16dp"
 android:layout_marginEnd="16dp"
 android:layout_marginBottom="18dp"
 android:orientation="vertical"
 app:layout_constraintBottom_toBottomOf="parent"
 app:layout_constraintEnd_toEndOf="parent"
 app:layout_constraintStart_toStartOf="parent">

 <LinearLayout
 android:layout_width="match_parent"
 android:layout_height="56dp"
 android:layout_marginBottom="12dp"
 android:background="@drawable/background_line"
 android:gravity="center_vertical"
 android:orientation="horizontal"
 android:paddingStart="14dp"
 android:paddingEnd="14dp">

 <com.kdt.mcgui.mcVersionSpinner
 android:id="@+id/mc_version_spinner"
 android:layout_width="0dp"
 android:layout_height="wrap_content"
 android:layout_weight="1"
 android:background="@android:color/transparent"
 android:drawableEnd="@drawable/spinner_arrow"
 android:textColor="@android:color/white"
 app:drawableEndPadding="2dp"
 app:drawableEndSize="18dp"
 app:drawableStartIntegerScaling="true"
 app:drawableStartSize="28dp" />

 <TextView
 android:id="@+id/version_label"
 android:layout_width="wrap_content"
 android:layout_height="wrap_content"
 android:layout_marginStart="12dp"
 android:text="Version"
 android:textColor="#CFCFCF"
 android:textSize="13sp" />
 </LinearLayout>

 <com.kdt.mcgui.MineButton
 android:id="@+id/play_button"
 android:layout_width="match_parent"
 android:layout_height="62dp"
 android:text="Play"
 android:textAllCaps="false" />
 </LinearLayout>

 <com.kdt.mcgui.LauncherMenuButton
 android:id="@+id/custom_control_button"
 android:layout_width="1dp"
 android:layout_height="1dp"
 android:alpha="0"
 android:visibility="invisible"
 tools:ignore="SpeakableTextPresentCheck" />

 <com.kdt.mcgui.LauncherMenuButton
 android:id="@+id/install_jar_button"
 android:layout_width="1dp"
 android:layout_height="1dp"
 android:alpha="0"
 android:visibility="invisible"
 tools:ignore="SpeakableTextPresentCheck" />

</androidx.constraintlayout.widget.ConstraintLayout>
